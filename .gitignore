# Dictionary build artifacts. data/dictionary.txt, the corpus derived from the
# upstream dump, is committed; the dump itself
# (data/viwiktionary-latest-pages-articles.xml.bz2, from `make fetch-dict`)
# and data/noitu.db (built from the corpus by `make dict`) are not. A plain
# .xml would be the dump decompressed by hand.
data/*.bz2
data/*.bz2.part
data/*.xml
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.tmp

# Go build output
/noitu-server
/noitu-server.exe
/build-dictionary
/build-dictionary.exe
*.test
*.out

# Node / SvelteKit
web/node_modules/
web/build/
web/.svelte-kit/
node_modules/

# Playwright
web/test-results/
web/playwright-report/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
